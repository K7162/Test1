{% extends 'base.html.twig' %}

{% block title %}{{ book.title }}{% endblock %}

{% block body %}
<h1>{{ book.title }}</h1>

<p><strong>Liczba stron:</strong> {{ book.totalPages }}</p>
<p><strong>Rok wydania:</strong> {{ book.publishedYear }}</p>
<p><strong>Gatunek:</strong> {{ book.genre.genre }}</p>
<p><strong>Wydawca:</strong> {{ book.publisher.name }}</p>

<p><strong>Autorzy:</strong>
    {% for author in book.authors %}
    {{ author.firstName }} {{ author.lastName }}{% if not loop.last %}, {% endif %}
    {% endfor %}
</p>

<a href="{{ path('book_edit', { id: book.id }) }}">Edytuj</a>
{% endblock %}